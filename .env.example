# Copia in .env e compila.
# In produzione DATABASE_URL viene da ~/infra/postgres/credentials/portfolio.env
# (host pg-shared sulla rete db-net).
DATABASE_URL=postgresql://utente:password@localhost:5432/portfolio_dev
PORT=3000
# Cartella dei file caricati (loghi, screenshot, CV). In Docker: /data/uploads
UPLOAD_DIR=./data/uploads
# Sessioni dell'admin: openssl rand -hex 32
SESSION_SECRET=
ADMIN_USERNAME=marco
# Generalo con: npm run admin:password
ADMIN_PASSWORD_HASH=
# Facoltativa: chiave DeepL API Free (finisce con :fx) per tradurre in automatico in inglese
DEEPL_API_KEY=
# URL pubblico del sito (link canonici e hreflang)
PUBLIC_URL=https://mdfdev.xyz
