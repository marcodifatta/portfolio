# Copia in .env e compila.
# In produzione DATABASE_URL viene da ~/infra/postgres/credentials/portfolio.env
# (host pg-shared sulla rete db-net).
DATABASE_URL=postgresql://utente:password@localhost:5432/portfolio_dev
PORT=3000
# Cartella dei file caricati (loghi, screenshot, CV). In Docker: /data/uploads
UPLOAD_DIR=./data/uploads
