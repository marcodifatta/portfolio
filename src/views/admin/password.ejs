<%- include("partials/top", { title }) %>
<% const esc = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); %>
<div class="page-head">
  <div>
    <h1>Cambia password</h1>
    <p class="lead">Dopo il cambio, le sessioni aperte su altri browser o dispositivi vengono chiuse.</p>
  </div>
</div>
<% if (Object.keys(errors).length) { %><div class="flash error" role="alert">Controlla i campi evidenziati.</div><% } %>
<form class="panel" method="post" action="/admin/password" novalidate style="max-width: 520px">
  <input type="hidden" name="_csrf" value="<%= csrf %>" />
  <input type="text" name="username" autocomplete="username" value="<%= locals.admin ? admin.username : '' %>" hidden />
  <% for (const [name, label, auto, hint] of [["current", "Password attuale", "current-password", ""], ["next", "Nuova password", "new-password", "Almeno 12 caratteri. Una frase di più parole è facile da ricordare e difficile da indovinare."], ["confirm", "Ripeti la nuova password", "new-password", ""]]) { %>
    <div class="field" style="margin-bottom: 16px">
      <label for="<%= name %>"><%= label %></label>
      <input id="<%= name %>" name="<%= name %>" type="password" autocomplete="<%= auto %>" required <%- errors[name] ? `aria-invalid="true" aria-describedby="${name}-error"` : "" %> />
      <% if (hint) { %><span class="hint"><%= hint %></span><% } %>
      <% if (errors[name]) { %><span class="error" id="<%= name %>-error"><%- esc(errors[name]) %></span><% } %>
    </div>
  <% } %>
  <div class="form-actions"><a class="btn btn-ghost" href="/admin/projects">Annulla</a><button class="btn" type="submit">Cambia password</button></div>
</form>
<%- include("partials/bottom") %>
