<%# Campi comuni ai form "aggiungi" e "modifica" di un link della pagina /link. %>
<div class="form-grid">
  <div class="field">
    <label for="title">Testo del link</label>
    <input id="title" name="title" type="text" maxlength="40" placeholder="ShoppyList" value="<%= values.title %>" <%- errors.title ? 'aria-invalid="true" aria-describedby="title-error"' : "" %> />
    <% if (errors.title) { %><span class="error" id="title-error"><%= errors.title %></span><% } %>
  </div>
  <div class="field">
    <label for="icon">Logo <span class="hint" style="display:inline">(facoltativo)</span></label>
    <input id="icon" name="icon" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" <%- errors.icon ? 'aria-invalid="true" aria-describedby="icon-error"' : "" %> />
    <span class="hint">Quadrato, PNG o SVG. Senza logo compare l'iniziale del testo.</span>
    <% if (errors.icon) { %><span class="error" id="icon-error"><%= errors.icon %></span><% } %>
  </div>
  <div class="field full">
    <label for="subtitle">Sottotesto <span class="hint" style="display:inline">(facoltativo)</span></label>
    <input id="subtitle" name="subtitle" type="text" maxlength="90" placeholder="Lista della spesa condivisa" value="<%= values.subtitle %>" <%- errors.subtitle ? 'aria-invalid="true" aria-describedby="subtitle-error"' : "" %> />
    <% if (errors.subtitle) { %><span class="error" id="subtitle-error"><%= errors.subtitle %></span><% } %>
  </div>
  <div class="field full">
    <label for="url">Collegamento</label>
    <input id="url" name="url" type="text" placeholder="https://shoppylist.mdfdev.net/" value="<%= values.url %>" <%- errors.url ? 'aria-invalid="true" aria-describedby="url-error"' : "" %> />
    <span class="hint">Un indirizzo https://… oppure un'email. Ai link web si aggiunge da solo da quale social arriva la visita (utm_source); se il link ha già dei parametri utm_, gli altri restano com'è.</span>
    <% if (errors.url) { %><span class="error" id="url-error"><%= errors.url %></span><% } %>
  </div>
  <div class="field full">
    <label for="note">Nota sotto il pulsante <span class="hint" style="display:inline">(facoltativa)</span></label>
    <input id="note" name="note" type="text" maxlength="160" placeholder="link affiliato: se compri lì ricevo una piccola commissione, senza costi per te" value="<%= values.note %>" <%- errors.note ? 'aria-invalid="true" aria-describedby="note-error"' : "" %> />
    <span class="hint">Testo piccolo sotto il pulsante, per esempio l'avviso di un link affiliato.</span>
    <% if (errors.note) { %><span class="error" id="note-error"><%= errors.note %></span><% } %>
  </div>
  <div class="field">
    <label for="event">Nome evento statistiche <span class="hint" style="display:inline">(facoltativo)</span></label>
    <input id="event" name="event" type="text" maxlength="50" placeholder="click-instantgaming" value="<%= values.event %>" <%- errors.event ? 'aria-invalid="true" aria-describedby="event-error"' : "" %> />
    <span class="hint">Vuoto: "click-" seguito dal testo del link.</span>
    <% if (errors.event) { %><span class="error" id="event-error"><%= errors.event %></span><% } %>
  </div>
  <fieldset class="field">
    <legend>Opzioni</legend>
    <label class="check"><input type="checkbox" name="newTab" <%= values.newTab ? "checked" : "" %> /> Apri in una nuova scheda</label>
    <label class="check"><input type="checkbox" name="sponsored" <%= values.sponsored ? "checked" : "" %> /> Link affiliato o sponsorizzato</label>
    <label class="check"><input type="checkbox" name="visible" <%= values.visible ? "checked" : "" %> /> Visibile sulla pagina /link</label>
  </fieldset>
</div>
