<!doctype html>
<%# Pagina provvisoria (Fasi 2-4): mostra i dati letti dal database. La grafica arriva nella Fase 5. %>
<html lang="<%= t.htmlLang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= t.siteTitle %></title>
    <meta name="description" content="<%= t.metaDescription %>" />
    <link rel="canonical" href="<%= urls.canonical %>" />
    <link rel="alternate" hreflang="it" href="<%= urls.it %>" />
    <link rel="alternate" hreflang="en" href="<%= urls.en %>" />
    <link rel="alternate" hreflang="x-default" href="<%= urls.it %>" />
    <link rel="icon" href="/assets/brand/favicon-32.png" type="image/png" />
    <style>
      body { font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 24px 16px; line-height: 1.5; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; padding: 0; list-style: none; }
      .card { border: 1px solid #ddd; border-radius: 12px; padding: 16px; }
      .card img { width: 56px; height: 56px; object-fit: contain; }
      .skills img { width: 32px; height: 32px; }
    </style>
  </head>
  <body>
    <p><a href="<%= urls.switchTo %>" hreflang="<%= t.langSwitch.hreflang %>" lang="<%= t.langSwitch.hreflang %>" aria-label="<%= t.langSwitch.aria %>"><%= t.langSwitch.label %></a></p>
    <h1><%= content.heroTitle %></h1>
    <p><%= content.heroSubtitle %></p>

    <h2><%= t.projects.title %></h2>
    <ul class="grid">
      <% for (const p of projects) { %>
        <li class="card" data-project="<%= p.slug %>">
          <% if (p.logoPath) { %><img src="<%= p.logoPath %>" alt="" width="56" height="56" /><% } %>
          <h3><a href="<%= p.url %>" rel="noopener" target="_blank"><%= p.title %></a></h3>
          <p><%= p.description %></p>
          <% if (p.year) { %><small><%= p.year %></small><% } %>
        </li>
      <% } %>
    </ul>

    <% if (content.about) { %><h2><%= t.about.title %></h2><p><%= content.about %></p><% } %>

    <h2><%= t.skills.title %></h2>
    <p class="skills">
      <% for (const s of skills) { %><img src="<%= s.iconPath %>" alt="<%= s.name %>" title="<%= s.name %>" /> <% } %>
    </p>

    <h2><%= t.contact.title %></h2>
    <ul>
      <% for (const s of socials) { %><li><a href="<%= s.url %>"><%= s.label %></a></li><% } %>
      <% if (content.cvPath) { %><li><a href="<%= content.cvPath %>" download><%= t.contact.cv %></a></li><% } %>
    </ul>
  </body>
</html>
